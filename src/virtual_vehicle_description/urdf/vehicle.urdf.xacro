<?xml version="1.0"?>

<robot name="virtual_vehicle" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Vehicle dimensions -->
    <xacro:property name="wheel_radius" value="0.16"/>
    <xacro:property name="wheel_width" value="0.10"/>
    <xacro:property name="wheel_separation" value="0.90"/>
    <xacro:property name="wheelbase" value="0.76"/>

    <!-- Materials -->
    <material name="blue">
        <color rgba="0.05 0.25 0.85 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.08 0.08 0.08 1.0"/>
    </material>

    <!-- Base footprint -->
    <link name="base_footprint"/>

    <!-- Main chassis -->
    <link name="base_link">

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="15.0"/>
            <inertia
                ixx="1.0"
                ixy="0.0"
                ixz="0.0"
                iyy="2.0"
                iyz="0.0"
                izz="2.5"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="1.2 0.8 0.25"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <box size="1.2 0.8 0.25"/>
            </geometry>
        </collision>

    </link>

    <!-- Base footprint to chassis -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.42" rpy="0 0 0"/>
    </joint>

    <!-- Wheel macro -->
    <xacro:macro name="wheel" params="name x y">

        <link name="${name}">

            <inertial>
                <mass value="1.0"/>
                <origin xyz="0 0 0"/>
                <inertia
                    ixx="0.01"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.01"
                    iyz="0.0"
                    izz="0.01"/>
            </inertial>

            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>

                <origin rpy="1.5707963 0 0"/>

                <material name="black"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>

                <origin rpy="1.5707963 0 0"/>
            </collision>

        </link>

        <joint name="${name}_joint" type="continuous">

            <parent link="base_link"/>
            <child link="${name}"/>

            <origin xyz="${x} ${y} -0.26"/>

            <axis xyz="0 1 0"/>

        </joint>

    </xacro:macro>

    <!-- Four wheels -->
    <xacro:wheel name="front_left_wheel"
                 x="0.38" y="0.45"/>

    <xacro:wheel name="front_right_wheel"
                 x="0.38" y="-0.45"/>

    <xacro:wheel name="rear_left_wheel"
                 x="-0.38" y="0.45"/>

    <xacro:wheel name="rear_right_wheel"
                 x="-0.38" y="-0.45"/>

    <!-- Gazebo material and friction -->
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
    </gazebo>

    <!-- Wheel friction -->
    <gazebo reference="front_left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="front_right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="rear_left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="rear_right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/Black</material>
    </gazebo>

 <!-- Differential Drive Plugin -->
<gazebo>

    <plugin name="differential_drive"
            filename="libgazebo_ros_diff_drive.so">

        <ros>
            <namespace>/</namespace>
        </ros>

        <update_rate>50</update_rate>

        <!-- Driven wheels -->
        <left_joint>front_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>

        <!-- Vehicle dimensions -->
        <wheel_separation>0.90</wheel_separation>
        <wheel_diameter>0.32</wheel_diameter>

        <!-- Motor parameters -->
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>5.0</max_wheel_acceleration>

        <!-- ROS 2 topics -->
        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>

        <!-- Frames -->
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>

        <!-- Publishing -->
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>

</gazebo>

    <!-- Joint state publisher plugin -->
    <gazebo>

        <plugin name="joint_state_publisher"
                filename="libgazebo_ros_joint_state_publisher.so">

            <update_rate>30</update_rate>

            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>

        </plugin>

    </gazebo>

</robot>